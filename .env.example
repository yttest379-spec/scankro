# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://scankro:scankro@localhost:5432/scankro?schema=public

# better-auth (generate a long random string)
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
